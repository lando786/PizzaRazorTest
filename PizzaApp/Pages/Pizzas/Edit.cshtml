@page "{id:int}"
@model PizzaApp.Pages.Pizzas.EditModel
@{
    ViewData["Title"] = "Edit Pizza";
}

<h1>Edit Pizza</h1>

<form method="post" data-testid="pizza-form">
    <input type="hidden" asp-for="Pizza.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Pizza.Name" class="form-label"></label>
        <input asp-for="Pizza.Name" class="form-control" data-testid="pizza-name" />
        <span asp-validation-for="Pizza.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Pizza.Description" class="form-label"></label>
        <textarea asp-for="Pizza.Description" class="form-control" data-testid="pizza-description"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Pizza.Price" class="form-label"></label>
        <input asp-for="Pizza.Price" class="form-control" data-testid="pizza-price" />
        <span asp-validation-for="Pizza.Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Pizza.Size" class="form-label"></label>
        <select asp-for="Pizza.Size" asp-items="Html.GetEnumSelectList<PizzaApp.Models.PizzaSize>()" class="form-select" data-testid="pizza-size"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Toppings</label>
        <p class="form-text" data-testid="maximum-toppings">Choose up to @Model.MaximumToppings toppings.</p>
        <span asp-validation-for="SelectedToppings" class="text-danger"></span>
        <div>
            @foreach (var topping in Model.AvailableToppings)
            {
                var isChecked = Model.SelectedToppings.Contains(topping);
                <div class="form-check form-check-inline">
                    <input type="checkbox" class="form-check-input" name="SelectedToppings" value="@topping"
                           id="topping-@topping.Replace(" ", "")" data-testid="pizza-toppings-@topping.Replace(" ", "")"
                           checked="@isChecked" />
                    <label class="form-check-label" for="topping-@topping.Replace(" ", "")">@topping</label>
                </div>
            }
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Pizza.ImageUrl" class="form-label"></label>
        <input asp-for="Pizza.ImageUrl" class="form-control" data-testid="pizza-image-url" />
    </div>

    <button type="submit" class="btn btn-primary" data-testid="save-pizza">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
