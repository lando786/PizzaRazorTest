@page "{id:int}"
@model PizzaApp.Pages.Pizzas.DeleteModel
@{
    ViewData["Title"] = "Delete Pizza";
}

<h1>Delete Pizza</h1>

<h3>Are you sure you want to delete this pizza?</h3>
<div data-testid="delete-confirmation">
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Pizza.Name</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Pizza.Description</dd>
        <dt class="col-sm-2">Size</dt>
        <dd class="col-sm-10">@Model.Pizza.Size</dd>
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Pizza.Price.ToString("C")</dd>
        <dt class="col-sm-2">Toppings</dt>
        <dd class="col-sm-10">@string.Join(", ", Model.Pizza.Toppings)</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Pizza.Id" />
        <button type="submit" class="btn btn-danger" data-testid="confirm-delete">Delete</button>
        <a asp-page="Index" class="btn btn-secondary" data-testid="cancel-delete">Cancel</a>
    </form>
</div>
